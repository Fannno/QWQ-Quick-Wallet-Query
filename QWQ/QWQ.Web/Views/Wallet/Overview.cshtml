@model List<QWQ.Web.Models.Wallet>

@{
    ViewData["Title"] = "我的錢包";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert"
         id="successMessage">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert"
         id="errorMessage">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>我的錢包</h2>
        <a asp-controller="Wallet" asp-action="Create" class="btn btn-primary">新增資產</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            目前沒有啟用中的資產。
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>資產名稱</th>
                    <th>資產類型</th>
                    <th>初始金額</th>
                    <th>建立時間</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var wallet in Model)
                {
                    <tr>
                        <td>@wallet.WalletName</td>
                        <td>
                            @switch (wallet.WalletType)
                            {
                                case "Cash":
                                    <text>現金</text>
                                    break;
                                case "Bank":
                                    <text>銀行存款</text>
                                    break;
                                case "EWallet":
                                    <text>電子錢包</text>
                                    break;
                            }
                        </td>
                        <td>@wallet.InitialBalance.ToString("N2")</td>
                        <td>@wallet.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td>
                            <a asp-controller="Wallet" asp-action="Edit" asp-route-id="@wallet.WalletId" class="btn btn-sm btn-outline-primary">編輯</a>
                            <form asp-controller="Wallet" asp-action="Deactivate" asp-route-id="@wallet.WalletId" method="post" class="d-inline" onsubmit="return confirm('確定要停用這項資產嗎？');">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    停用
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        setTimeout(() => {
            document.querySelectorAll('.alert-dismissible').forEach(message => {
                bootstrap.Alert.getOrCreateInstance(message).close();
            });
        }, 3000);
    </script>
}