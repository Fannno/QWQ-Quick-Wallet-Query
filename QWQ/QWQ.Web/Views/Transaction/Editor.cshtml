@model QWQ.Web.ViewModels.Transaction.TransactionEditorViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    bool isEdit = Model.TransactionId.HasValue;
    ViewData["Title"] = isEdit ? "編輯交易" : "新增交易";
    string actionName = isEdit ? "Edit" : "Create";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">@ViewData["Title"]</h2>

            @using (Html.BeginForm(actionName, "Transaction", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                @Html.HiddenFor(model => model.TransactionId)

                <div class="mb-3">
                    @Html.LabelFor(model => model.TransactionType, new { @class = "form-label" })
                    @Html.DropDownListFor(model => model.TransactionType, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "收入", Value = "Income" },
                        new SelectListItem { Text = "支出", Value = "Expense" }
                    }, "請選擇交易類型", new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.TransactionType, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.WalletId, new { @class = "form-label" })
                    @Html.DropDownListFor(model => model.WalletId, Model.WalletOptions, "請選擇資產", new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.WalletId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Title, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Amount, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", type = "number", step = "0.01", min = "0.01" })
                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.CategoryName, new { @class = "form-label" })
                    <select id="CategoryName" name="CategoryName" class="form-select">
                        <option value="">請選擇交易類別</option>
                    </select>
                    @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.TransactionDate, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.TransactionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(model => model.TransactionDate, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Note, new { @class = "form-label" })
                    @Html.TextAreaFor(model => model.Note, new { @class = "form-control", rows = "3" })
                    @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(isEdit ? "儲存修改" : "新增")</button>
                    <a asp-controller="Transaction" asp-action="Overview" class="btn btn-secondary">返回</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categories = {
            Income: ["薪資", "獎金", "生活費", "兼職收入", "投資收益", "其他收入"],
            Expense: ["餐飲", "交通", "購物", "娛樂", "生活用品", "房租／住宿", "水電瓦斯", "醫療", "教育", "其他支出"]
        };

        const typeSelect = document.getElementById("TransactionType");
        const categorySelect = document.getElementById("CategoryName");
        let savedCategory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryName));

        function updateCategories() {
            const type = typeSelect.value;
            const currentCategory = categorySelect.value || savedCategory;
            const options = categories[type] || [];

            categorySelect.innerHTML = '<option value="">請選擇交易類別</option>';

            if (currentCategory && !options.includes(currentCategory)) {
                options.push(currentCategory);
            }

            options.forEach(category => {
                const option = new Option(category, category);
                option.selected = category === currentCategory;
                categorySelect.add(option);
            });
        }

       typeSelect.addEventListener("change", () => {
            savedCategory = "";
            categorySelect.value = "";
            updateCategories();
        });

        updateCategories();
    </script>
}